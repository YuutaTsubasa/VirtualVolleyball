{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VirtualVolleyballKing",
  "version": "0.1.3",
  "identifier": "com.yuuta.mahjongvolleyball",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "虛擬排球王",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
